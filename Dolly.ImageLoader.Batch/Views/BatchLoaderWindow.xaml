<Window x:Class="Dolly.ImageLoader.Batch.Views.BatchLoaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Dolly.ImageLoader.Batch.ViewModels"
        xmlns:sharedViewModels="clr-namespace:Dolly.ImageLoader.Wpf.Shared.ViewModels;assembly=Dolly.ImageLoader.Wpf.Shared"
        xmlns:views="clr-namespace:Dolly.ImageLoader.Wpf.Shared.Views;assembly=Dolly.ImageLoader.Wpf.Shared"
        mc:Ignorable="d"
        Title="Dolly Batch Loader"
        Height="860"
        Width="1500"
        MinHeight="760"
        MinWidth="1260"
        WindowStartupLocation="CenterOwner"
        Background="#F7F7F7"
        AllowDrop="{Binding IsInteractionLocked, Converter={StaticResource InverseBooleanConverter}}"
        Drop="Window_Drop">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                IsEnabled="{Binding IsInteractionLocked, Converter={StaticResource InverseBooleanConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Dolly Batch Loader"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#222222" />
                    <TextBlock Text="Load a group, browse products, and prepare image batches"
                               FontSize="11"
                               Foreground="DimGray" />
                </StackPanel>

                <TextBox Grid.Column="2"
                         x:Name="GroupSearchTextBox"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="13"
                         Text="{Binding GroupSearchText, UpdateSourceTrigger=PropertyChanged}" 
                         KeyDown="GroupSearchTextBox_KeyDown"/>

                <Button Grid.Column="4"
                        x:Name="LoadGroupButton"
                        Height="30"
                        Content="Load Group"
                        Command="{Binding LoadGroupCommand}" />

                <Button Grid.Column="6"
                        Height="30"
                        Content="Add Images"
                        Command="{Binding AddImagesCommand}" />

                <Button Grid.Column="8"
                        Height="30"
                        Content="Save All"
                        Command="{Binding SaveAllCommand}"
                        IsEnabled="{Binding CanSaveAll}" />
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="810" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    IsEnabled="{Binding IsInteractionLocked, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Products / Group"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding ProductTree}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:BatchProductNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right"
                                               Margin="6,0,0,0"
                                               Text="●"
                                               Foreground="#2E8B57"
                                               FontWeight="Bold"
                                               Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="{Binding IsGroup, Converter={StaticResource BooleanToFontWeightConverter}}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="DimGray" />
                                    </StackPanel>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="True" />
                                <EventSetter Event="Selected" Handler="TreeViewItem_Selected" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Middle -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    IsEnabled="{Binding IsInteractionLocked, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.0*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target Type"
                                       FontSize="11"
                                       Foreground="DimGray" />
                            <TextBlock Text="{Binding SelectedTargetMode}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Selected Target"
                                       FontSize="11"
                                       Foreground="DimGray" />
                            <TextBlock Text="{Binding SelectedProduct.ProductId}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Suppliers Product Code"
                                       FontSize="11"
                                       Foreground="DimGray" />
                            <TextBlock Text="{Binding SelectedProduct.SupplierProductCode}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Parent Group"
                                       FontSize="11"
                                       Foreground="DimGray" />
                            <TextBlock Text="{Binding SelectedProduct.ParentGroupId}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0"
                                        Content="{Binding SelectedPrimarySlot}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type sharedViewModels:ImageSlotViewModel}">
                                    <Border BorderThickness="2"
                                            BorderBrush="Transparent"
                                            CornerRadius="6"
                                            Padding="2"
                                            AllowDrop="{Binding DataContext.IsInteractionLocked, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                            PreviewMouseLeftButtonDown="SlotBorder_PreviewMouseLeftButtonDown"
                                            Drop="SlotBorder_Drop"
                                            Tag="{Binding}">
                                        <views:ImageSlotCardView />
                                    </Border>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <ItemsControl Grid.Column="2"
                                      ItemsSource="{Binding SelectedSecondarySlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type sharedViewModels:ImageSlotViewModel}">
                                    <Border Margin="2"
                                            BorderThickness="2"
                                            BorderBrush="Transparent"
                                            CornerRadius="6"
                                            Padding="2"
                                            AllowDrop="{Binding DataContext.IsInteractionLocked, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}}"
                                            PreviewMouseLeftButtonDown="SlotBorder_PreviewMouseLeftButtonDown"
                                            Drop="SlotBorder_Drop"
                                            Tag="{Binding}">
                                        <views:ImageSlotCardView />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid AllowDrop="{Binding IsInteractionLocked, Converter={StaticResource InverseBooleanConverter}}"
                      Drop="ImagePool_Drop"
                      IsEnabled="{Binding IsInteractionLocked, Converter={StaticResource InverseBooleanConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Image Pool"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Height="24"
                                Padding="10,2"
                                Content="Clear Pool"
                                Command="{Binding ClearImagePoolCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Drag and drop images here or double-click to assign to selected slot"
                               FontSize="11"
                               Foreground="DimGray"
                               TextWrapping="Wrap" />

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding ImagePool}"
                             BorderThickness="0"
                             Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             PreviewMouseMove="ImagePoolListBox_PreviewMouseMove"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:BatchImagePoolItemViewModel}">
                                <Border Margin="0,0,0,6"
                                        Padding="6"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="#FAFAFA">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.AssignPoolImageToSelectedSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="60"
                                                Height="60"
                                                Background="White"
                                                BorderBrush="#D9D9D9"
                                                BorderThickness="1"
                                                ToolTip="{Binding TooltipText}">
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Button Grid.Column="4"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                FontWeight="Bold"
                                                Content="×"
                                                Command="{Binding DataContext.RemovePoolImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="#333333" />

                <TextBlock Grid.Column="1"
                           Text="{Binding PendingTargetCount, StringFormat=Pending targets: {0}}"
                           VerticalAlignment="Center"
                           Foreground="#2F4F7F"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Column="3"
                           Text="{Binding IsBusy, StringFormat=Busy: {0}}"
                           VerticalAlignment="Center"
                           Foreground="DimGray" />
            </Grid>
        </Border>

        <!-- Busy overlay -->
        <Border Grid.RowSpan="5"
                Background="#66FFFFFF"
                Visibility="{Binding IsInteractionLocked, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Grid>
                <Border Width="320"
                        Padding="16"
                        CornerRadius="8"
                        Background="White"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Working..."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"
                                   HorizontalAlignment="Center" />

                        <TextBlock Margin="0,8,0,10"
                                   Text="{Binding StatusMessage}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="DimGray" />

                        <ProgressBar Height="14"
                                     IsIndeterminate="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>