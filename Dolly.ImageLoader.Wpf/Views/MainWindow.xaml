<Window x:Class="Dolly.ImageLoader.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Dolly.ImageLoader.Wpf.ViewModels"
        xmlns:views="clr-namespace:Dolly.ImageLoader.Wpf.Views"
        mc:Ignorable="d"
        Title="Dolly Image Loader"
        Height="880"
        Width="1080"
        MinHeight="880"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F7">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Dolly Image Loader"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#222222" />
                    <TextBlock Text="STEP and Amazon image management"
                               FontSize="11"
                               Foreground="DimGray" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <TextBox x:Name="SearchTextBox"
                             Height="32"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             FontSize="13"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_OnKeyDown">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding CommitSearchSelectionCommand}" />
                            <KeyBinding Key="Down"
                                        Command="{Binding MoveSearchSelectionDownCommand}" />
                            <KeyBinding Key="Up"
                                        Command="{Binding MoveSearchSelectionUpCommand}" />
                            <KeyBinding Key="Escape"
                                        Command="{Binding CloseSearchResultsCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Popup IsOpen="{Binding IsSearchResultsOpen}"
                           PlacementTarget="{Binding ElementName=SearchTextBox}"
                           Placement="Bottom"
                           HorizontalOffset="0"
                           VerticalOffset="2"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="{Binding ActualWidth, ElementName=SearchTextBox}"
                                Background="White"
                                BorderBrush="#CFCFCF"
                                BorderThickness="1"
                                CornerRadius="4"
                                MaxHeight="280">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         BorderThickness="0"
                                         Background="White"
                                         ItemsSource="{Binding SearchResults}"
                                         SelectedItem="{Binding SelectedSearchResult}"
                                         SelectedIndex="{Binding HighlightedSearchResultIndex}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:ProductSearchResultViewModel}">
                                            <Button Padding="10,8"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TitleText}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding DetailText}"
                                                               Foreground="DimGray"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="1"
                                        BorderBrush="#E5E5E5"
                                        BorderThickness="0,1,0,0"
                                        Background="#FAFAFA"
                                        Padding="8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding SearchResults.Count, StringFormat=Results: {0}}"
                                                   Foreground="DimGray"
                                                   VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right"
                                                Content="Close"
                                                Padding="8,2"
                                                Command="{Binding CloseSearchResultsCommand}" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="4"
                        Height="32"
                        Content="Search"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="6"
                        Height="32"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}" />

                <Button Grid.Column="8"
                        Height="32"
                        Content="Batch Loader"
                        Command="{Binding OpenBatchLoaderCommand}" />

                <Button Grid.Column="10"
                        Height="32"
                        Content="Save Changes"
                        FontWeight="SemiBold"
                        Command="{Binding SaveChangesCommand}"
                        IsEnabled="{Binding CanSaveChanges}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Selected Product"
                               FontSize="11"
                               Foreground="DimGray" />
                    <TextBlock Text="{Binding SelectedProduct.ProductId}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Product Name"
                               FontSize="11"
                               Foreground="DimGray" />
                    <TextBlock Text="{Binding SelectedProduct.ProductName}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Parent Group"
                               FontSize="11"
                               Foreground="DimGray" />
                    <TextBlock Text="{Binding SelectedProduct.ParentGroupId}"
                               FontSize="13"
                               FontWeight="SemiBold" />
                </StackPanel>

                <ToggleButton Grid.Column="3"
                              Padding="14,6"
                              MinWidth="84"
                              Content="Product"
                              IsChecked="{Binding IsProductMode}" />

                <ToggleButton Grid.Column="5"
                              Padding="14,6"
                              MinWidth="84"
                              Content="Group"
                              IsChecked="{Binding IsGroupMode}" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0"
                            Content="{Binding PrimarySlot}">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ImageSlotViewModel}">
                        <views:ImageSlotCardView />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding SecondarySlots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" Rows="3" />
                    </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ImageSlotViewModel}">
                        <views:ImageSlotCardView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="6"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#333333" />

                <TextBlock Grid.Column="1"
                           Text="{Binding PendingChangesCount, StringFormat=Pending changes: {0}}"
                           VerticalAlignment="Center"
                           Foreground="#2F4F7F"
                           FontWeight="SemiBold" />

                <TextBlock Grid.Column="3"
                           Text="{Binding IsBusy, StringFormat=Busy: {0}}"
                           VerticalAlignment="Center"
                           Foreground="DimGray" />
            </Grid>
        </Border>
    </Grid>
</Window>