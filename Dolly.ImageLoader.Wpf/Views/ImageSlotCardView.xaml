<UserControl x:Class="Dolly.ImageLoader.Wpf.Views.ImageSlotCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="210"
             MinWidth="190"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Margin="4"
            Padding="8"
            Background="White"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#D8D8D8" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                        <Setter Property="BorderBrush" Value="#6FA86F" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid ToolTipService.ShowDuration="60000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding DisplayLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#222222" />

                <Border Grid.Column="1"
                        Background="#FFF3CD"
                        BorderBrush="#F0D98A"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Warning"
                               Foreground="#7A5A00"
                               FontSize="10"
                               FontWeight="SemiBold" />
                </Border>

                <Button Grid.Column="3"
                        Width="24"
                        Height="22"
                        Padding="0"
                        FontSize="10"
                        Content="↺"
                        ToolTip="Revert this slot"
                        Command="{Binding RevertImageCommand}"
                        IsEnabled="{Binding CanRevert}" />

                <Button Grid.Column="5"
                        Width="22"
                        Height="22"
                        Padding="0"
                        FontWeight="Bold"
                        Content="×"
                        ToolTip="Clear image"
                        Command="{Binding ClearImageCommand}"
                        IsEnabled="{Binding CanClear}" />
            </Grid>

            <Border Grid.Row="2"
                    Cursor="Hand"
                    SnapsToDevicePixels="True"
                    CornerRadius="4"
                    BorderThickness="1"
                    ToolTipService.ShowDuration="60000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#F4F4F4" />
                        <Setter Property="BorderBrush" Value="#E2E2E2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEF6FF" />
                                <Setter Property="BorderBrush" Value="#7DA2CE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasPendingChange}" Value="True">
                                <Setter Property="Background" Value="#F3FBF3" />
                                <Setter Property="BorderBrush" Value="#6FA86F" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Border.ToolTip>
                    <ToolTip Placement="Mouse">
                        <StackPanel MaxWidth="320">
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />

                            <TextBlock Text="{Binding CurrentAssetDisplayText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding PendingActionText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />

                            <TextBlock Text="{Binding ValidationMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="#8A1F1F"
                                       Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>

                <Grid Background="Transparent">
                    <Grid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick"
                                      Command="{Binding ReplaceImageCommand}" />
                    </Grid.InputBindings>

                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both">
                        <Border Width="220"
                                Height="220"
                                Background="Transparent">
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Viewbox>

                    <TextBlock Text="Double-click to choose image"
                               Foreground="Gray"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Background="#66000000"
                            CornerRadius="4"
                            Opacity="0"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding PreviewImage}" Value="{x:Null}">
                                        <Setter Property="Opacity" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="Double-click to replace image"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Padding="6"
                    Background="#FDEAEA"
                    BorderBrush="#E1B1B1"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ValidationMessage}"
                           TextWrapping="Wrap"
                           Foreground="#8A1F1F"
                           FontSize="10.5" />
            </Border>
        </Grid>
    </Border>
</UserControl>